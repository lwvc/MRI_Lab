# Ignore everything
/*

# Keep .gitignore
!/.gitignore

# Keep folders
!/models/
!/result/

# Keep all subfolders
!/models/**/
!/result/**/

# Models: only code files
!/models/**/*.py
!/models/**/*.ipynb

# Result: keep everything
!/result/**

# VSCode settings
/result/.vscode/
/result/**/.vscode/

# Medical images
*.nii
*.nii.gz

# Compressed files
*.zip
*.7z
*.rar

# Cache
**/__pycache__/
**/.ipynb_checkpoints/

# Python cache
*.pyc
*.pyo

# Models output
models/**/*.xlsx

models/**/*.pt

**/.vscode/